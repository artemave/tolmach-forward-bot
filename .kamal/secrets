# Secrets pulled from Bitwarden Password Manager via `kamal secrets fetch`.
# Kamal reads this file at deploy time to populate the secrets referenced
# by `env.secret:` in config/deploy.yml.
#
# One-time setup:
#   brew install bitwarden-cli   # or your platform's package manager
#   bw login                     # authenticate the CLI to your account
#
# Per-shell session, before running `kamal deploy`:
#   export BW_SESSION=$(bw unlock --raw)
#
# Reference: https://kamal-deploy.org/docs/configuration/environment-variables/
#
# Fill in ACCOUNT and ITEM below.
#   ACCOUNT = your Bitwarden account email
#   ITEM    = name (or UUID) of the vault item whose custom fields hold
#             the three secrets listed on the right

SECRETS=$(kamal secrets fetch --adapter bitwarden --account dev@artem.rocks --from tolmach-forward-bot-kamal KAMAL_REGISTRY_PASSWORD TELEGRAM_BOT_TOKEN DEEPSEEK_API_KEY)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
TELEGRAM_BOT_TOKEN=$(kamal secrets extract TELEGRAM_BOT_TOKEN $SECRETS)
DEEPSEEK_API_KEY=$(kamal secrets extract DEEPSEEK_API_KEY $SECRETS)
