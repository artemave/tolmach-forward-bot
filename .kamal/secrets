# Kamal reads this file at deploy time and uses it to populate the secrets
# referenced by `env.secret:` in config/deploy.yml. Values come from the
# shell environment when you run `kamal deploy` — nothing sensitive is
# stored in the repo.
#
# Set these in your shell (or a local untracked .envrc / direnv profile)
# before deploying:
#
#   export KAMAL_REGISTRY_PASSWORD=...   # GHCR PAT with write:packages
#   export TELEGRAM_BOT_TOKEN=...        # @tolmach_forward_bot Bot API token
#   export DEEPSEEK_API_KEY=...          # DeepSeek API key
#
# Alternatively, replace any of these lines with a `kamal secrets fetch ...`
# call to a vault (1Password, Bitwarden, Doppler, etc.) - see
# https://kamal-deploy.org/docs/configuration/environment-variables/

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
DEEPSEEK_API_KEY=$DEEPSEEK_API_KEY
