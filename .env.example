# Telegram Bot API token from @BotFather (required).
TELEGRAM_BOT_TOKEN=

# DeepSeek API key (required).
DEEPSEEK_API_KEY=

# Model name passed to the OpenAI-compatible client (optional).
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible base URL for DeepSeek (optional).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Path to the SQLite database file (optional).
DATABASE_PATH=tolmach.db
