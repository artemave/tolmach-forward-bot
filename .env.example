# Telegram Bot API token from @BotFather (required).
TELEGRAM_BOT_TOKEN=

# OpenAI API key (required).
OPENAI_API_KEY=

# Model name passed to the OpenAI client (optional).
OPENAI_MODEL=gpt-4o-mini

# OpenAI API base URL (optional). Set this to point at another
# OpenAI-compatible endpoint (e.g. a self-hosted gateway).
OPENAI_BASE_URL=https://api.openai.com/v1

# Path to the SQLite database file (optional).
DATABASE_PATH=tolmach.db
